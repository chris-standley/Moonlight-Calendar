<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Moonlight looks for your family calendar on your home network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_home-assistant._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The add-on is served over plain http on the home network (port 8099), under whatever name the house uses. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
