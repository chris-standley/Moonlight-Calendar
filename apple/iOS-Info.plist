<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Moonlight looks for your family calendar on your home network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_home-assistant._tcp</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.chris-standley.moonlight.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Moonlight uses the camera to scan recipes from cookbooks and to take recipe pictures.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>In hands-free cook mode, Moonlight listens for "next", "back", "repeat" and "start the timer".</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hands-free cook mode understands "next", "back", "repeat" and "start the timer" on your phone.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The add-on is served over plain http on the home network (port 8091 by default), under whatever name the house uses. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
